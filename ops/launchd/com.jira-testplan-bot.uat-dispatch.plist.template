<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jira-testplan-bot.uat-dispatch</string>

  <!-- One tick per launch. A tick that is still running a leg holds a file
       lock, so the next launch exits at once instead of starting a second
       run on the same simulator. -->
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/ops/launchd/uat-dispatch.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <!-- Every 5 minutes. Queued runs start within one interval of the watcher
       queueing them; waiting runs are rechecked on their own schedule
       (UAT_BUILD_RECHECK_MIN). Outside WATCH_ACTIVE_DAYS/HOURS a tick does
       nothing. -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/jira-testplan-uat-dispatch.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/jira-testplan-uat-dispatch.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
