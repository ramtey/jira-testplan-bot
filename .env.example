# --- Jira ---
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=you@company.com
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN

# --- LLM Configuration ---
# Provider: "claude" (Anthropic API, recommended) or "ollama" (local, free)
LLM_PROVIDER=claude

# Model name. Leave unset to take the app default (currently claude-opus-5,
# defined in src/app/model_capabilities.py). Set it to pin an older Claude,
# or to name an Ollama model: llama3.1, qwen2.5, etc.
# LLM_MODEL=claude-opus-5

# Anthropic API key (required for Claude)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ollama server URL (only needed if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Read timeout (seconds) for Claude test-plan generation. Default 600s.
# Bump higher if you regularly generate plans for parents with many subtasks
# or other prompts that drive Opus to its 16k output-token cap.
CLAUDE_API_TIMEOUT_SECONDS=600

# --- GitHub (Optional - Phase 3a+3b+4) ---
# GitHub Personal Access Token for enhanced test plan context:
#   Phase 3a: PR code diffs and file changes
#   Phase 3b: PR comments and review discussions
#   Phase 4: Repository documentation (README.md) and test file examples
# Required scopes: repo (full control of private repositories)
# Get your token from https://github.com/settings/tokens
# IMPORTANT: If your organization uses SAML SSO, you must authorize the token
#            (Settings → Personal access tokens → Configure SSO → Authorize)
GITHUB_TOKEN=

# --- Source grounding ---
# Refuse to write a plan for a ticket with no merged and no open pull
# request. A ten-case plan of speculation is worse than no plan, because it
# looks authoritative. When this is on and no source is found, the bot emits
# a short "no implementation found" result naming what it searched instead.
# Pull requests closed WITHOUT merging are never used as grounding either
# way — that is not configurable, because code that was abandoned cannot be
# tested. Turn this off only if your tickets routinely carry implementation
# the bot cannot see (no Jira-GitHub integration, no PR links in the text).
REQUIRE_SOURCE_GROUNDING=true

# --- Copy-only plan shape ---
# When a single ticket's diff reads as user-visible strings (plus the
# constants that select between them, and their tests), the generator prompt
# gains a block that makes the model classify the diff and, if it agrees, cap
# the manual checklist at (distinct copy variants) + 4 — one case per variant,
# one retired-copy sweep, one narrowest-width layout check, one error/empty
# state, one keyboard pass. Persistence, payload shape, cache invalidation and
# prop wiring are marked covered_by_unit_test instead of shipped as manual
# cases. Costs no extra LLM call: a deterministic diff scan plus prompt text.
# The detector never decides on its own — it only decides whether to ask —
# and a PR whose diff could not be read never triggers the block at all.
# Turn this off to get the pre-rule behaviour, where a six-sentence copy
# change could ship thirty cases.
COPY_ONLY_RULE_ENABLED=true

# --- Figma (Optional - Phase 5) ---
# Figma Personal Access Token for design context:
#   Automatically extracts Figma URLs from Jira ticket descriptions
#   Fetches design file metadata, frames/screens, and UI components
#   Enriches test plans with actual design element names
# Required scopes: File content (read-only)
# Get your token from: Figma → Settings → Account → Personal access tokens
# Help: https://help.figma.com/hc/en-us/articles/8085703771159-Manage-personal-access-tokens
FIGMA_TOKEN=

# A real Figma file key the health check reads, to prove design context still
# works. Without one the check can only prove the token authenticates: Figma
# bills /v1/files by what it returns, so a nonexistent key answers 404 for free
# even while the quota for real files is spent. On 2026-09-16 that gap hid a
# 2.8-day outage during which every plan with a Figma link silently shipped
# without design context. Use a long-lived file the token can open — the key is
# the part of a Figma URL after /file/, /design/ or /proto/.
FIGMA_HEALTHCHECK_FILE_KEY=

# --- App ---
APP_ENV=local

# --- MongoDB (Required) ---
# Everything the bot remembers lives here: generated plans and their test cases,
# run history, Bug Lens analyses, per-ticket walkthroughs, QA progress and holds.
# Without it the app still fetches tickets and generates plans, but nothing
# persists and the version-history banner stays empty.
#
# Point this at a NON-PRODUCTION cluster. The bot writes on every ticket fetch,
# and the queue watcher writes unattended on a schedule.
#
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jira_testplan_bot
# Local:  mongodb://localhost:27017/jira_testplan_bot?replicaSet=rs0
#
# A replica set (any Atlas cluster is one) enables multi-document transactions,
# which plan writes and the Jira-posted-version swap use. Against a standalone
# mongod those degrade to separate writes rather than failing — fine for local
# development, not what you want for shared use.
MONGODB_URI=mongodb://localhost:27017/jira_testplan_bot
# Optional. Only needed when the URI above carries no database name in its path.
# MONGODB_DB=jira_testplan_bot

# --- QA-queue watcher (Optional) ---
# `testplan watch` pre-generates a test plan the moment a ticket lands in
# the QA queue, so the tester opens a ticket whose plan and critic verdicts
# are already waiting instead of starting a multi-minute Opus run by hand.
# Runs as its own process, never from the API.
#
# Every sweep makes real Opus calls with nobody watching, so each guard
# below is separately configurable. Start with `testplan watch --dry-run
# --once` to see what a real sweep would pick up.
#
# Projects to sweep, as JSON. Empty falls back to WORKFLOW_PROJECT_PREFIXES
# so the team's projects are named in one place.
WATCH_PROJECTS=
# The status that means "landed in the QA queue" — the trigger moment.
WATCH_STATUS=Ready to Test
# Seconds between sweeps. Boards move on human timescales; polling faster
# buys nothing but Jira API calls.
WATCH_INTERVAL_SECONDS=300
# Cap on plans generated per sweep. Bounds the bill when a sprint's worth
# of tickets moves to the queue status at once.
WATCH_MAX_PER_CYCLE=5
# Require at least one MERGED pull request. Merge state, not just existence:
# a plan written against an open PR describes code that is still changing,
# and the watcher never regenerates, so that plan would outlive the code.
WATCH_REQUIRE_MERGED_PR=true
# Tickets a QA has put on hold are always skipped, whatever the reason —
# `code-review` means the PR is still in review, and deferring is free
# because the next sweep after the hold clears still beats the tester to it.
#
# Don't re-attempt a ticket attempted (successfully or not) this recently.
# Stops a ticket that fails every cycle from burning a call every interval.
WATCH_RETRY_COOLDOWN_HOURS=6

# --- Your team (Optional, but the bot is dumber without it) ---
# These describe whoever is running the bot — the Jira projects, the people,
# the repos. They are config rather than code precisely so a clone doesn't
# inherit someone else's team.
#
# Jira projects whose tickets get the QA workflow buttons (Pull to Testing,
# Pass to UAT, Fail back), as JSON. Empty means no workflow buttons anywhere,
# which is the safe default but also means the hand-off UI stays hidden.
WORKFLOW_PROJECT_PREFIXES=["SK"]
#
# GitHub login -> [Jira accountId, display name]. Used to decide who a
# fail-back is assigned to: the bot picks the PR author with the most changed
# lines, then has to turn that GitHub login into a Jira user. Without this it
# falls back to searching Jira by commit email, then profile name, then login
# — which misses anyone whose GitHub name differs from their Jira name, or who
# commits through a GitHub noreply address. Find an accountId in any Jira API
# response, or at /rest/api/3/user/search?query=<email>.
TEAM_GITHUB_LOGIN_TO_JIRA={"octocat": ["557058:00000000-0000-0000-0000-000000000000", "Octo Cat"]}
#
# Jira display names of service/bot accounts that must never be left holding a
# ticket after a hand-off, as JSON. Matched case-insensitively.
BOT_DISPLAY_NAMES=["testing acme"]
#
# Product keyword -> repos to code-search when a bug ticket has no linked PR,
# as JSON. The key is a case-insensitive regex matched against summary +
# description + comments.
BUG_LENS_REPO_HINTS={"agent.?cal(culator)?": ["acme/agent-calculator"]}
